# Ojastra Environment Variables
PORT=3000
DEMO_PORT=3001
WEB_PORT=5173

# LLM Provider Configuration
# Set LLM_PROVIDER to 'gemini' (Recommended - 100% Free with Google AI Studio), 'mistral', 'openai', or 'vector-engine'
LLM_PROVIDER=gemini

# 1. Google Gemini (100% Free - get key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. Mistral (Optional)
MISTRAL_API_KEY=your_mistral_api_key_here
LLM_MODEL=mistral-small-latest

# 3. OpenAI / Groq / OpenRouter (Optional)
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Storage and Database
STORAGE_DIR=./storage
LLM_TIMEOUT_MS=45000
DATABASE_PATH=./storage/ojastra.db
