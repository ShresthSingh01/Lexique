{
  "name": "ojastra-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n demo,api,web -c blue,green,magenta \"pnpm --filter @intentlock/demo-app dev\" \"pnpm --filter @intentlock/api dev\" \"pnpm --filter @intentlock/web dev\"",
    "dev:demo": "pnpm --filter @intentlock/demo-app dev",
    "dev:api": "pnpm --filter @intentlock/api dev",
    "dev:web": "pnpm --filter @intentlock/web dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:e2e": "vitest run tests/e2e/workbench.test.ts",
    "test:judge": "tsx scripts/judge-terminal-suite.ts",
    "test:judge:demo": "tsx scripts/judge-terminal-suite.ts --demo",
    "test:judge:step": "tsx scripts/judge-terminal-suite.ts --interactive"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
